<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Spacing="12" Padding="12">
        <Label Text="Descrição do Produto:" FontAttributes="Bold" />
        <Entry x:Name="txt_descricao" Placeholder="Ex: Arroz Integral" />

        <Label Text="Quantidade:" FontAttributes="Bold" />
        <Entry x:Name="txt_quantidade" Keyboard="Numeric" Placeholder="Ex: 2" />

        <Label Text="Valor Unitário:" FontAttributes="Bold" />
        <Entry x:Name="txt_valorUnitario" Keyboard="Numeric" Placeholder="Ex: 5.50" />

        <Label Text="Data da Compra:" FontAttributes="Bold" />
        <DatePicker x:Name="dtp_dataCadastro" Format="dd/MM/yyyy" />

    </VerticalStackLayout>
</ContentPage>