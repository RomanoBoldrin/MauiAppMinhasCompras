<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiAppMinhasCompras.Models" 
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1" />
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Clicked" />
        <ToolbarItem Text="Relatório" Clicked="ToolbarItem_Relatorio_Clicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Inherit from the app-wide base label style so we don't lose TextColor settings -->
            <Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <SearchBar x:Name="txt_search" 
                   Grid.Row="0"
                   Margin="10, 10, 10, 0"
                   Placeholder="Busca de Produtos"
                   TextChanged="txt_search_TextChanged" />

        <Border Grid.Row="1"
                Padding="0" 
                Margin="10"
                StrokeThickness="1"
                Stroke="{StaticResource Gray200}">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <RefreshView x:Name="refresh_view" Refreshing="refresh_view_Refreshing">

                <CollectionView x:Name="Lista_produtos" 
                                SelectionMode="Single"
                                SelectionChanged="List_Produtos_SelectionChanged">

                    <CollectionView.Header>
                        <Grid ColumnDefinitions="30, 100, 80, 50, 90" 
                              BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#2A2A2A}">
                            <Label Grid.Column="0" Text="ID" Padding="5" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Descrição" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="Preço" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="Qnt" FontAttributes="Bold" />
                            <Label Grid.Column="4" Text="Total" FontAttributes="Bold" />
                        </Grid>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Produto">
                            <Grid ColumnDefinitions="30, 100, 80, 50, 90" BackgroundColor="Transparent">

                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Remover" Clicked="MenuItem_Clicked" />
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>

                                <Label Grid.Column="0" Text="{Binding Id}" Padding="5" TextColor="White" />
                                <Label Grid.Column="1" Text="{Binding Descricao}" TextColor="White" />
                                <Label Grid.Column="2" Text="{Binding Preco, StringFormat='{}{0:c}'}" TextColor="White" />
                                <Label Grid.Column="3" Text="{Binding Quantidade}" TextColor="White"/>
                                <Label Grid.Column="4" Text="{Binding Total, StringFormat='{}{0:c}'}" TextColor="White" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </RefreshView>
        </Border>
    </Grid>
</ContentPage>
    